DATABASE_URL=postgresql+asyncpg://betapp:replace-me@localhost:5432/betapp213
APP_ENV=development
LOG_LEVEL=INFO
SCRAPER_API_TOKEN=replace-with-a-long-random-token
SCRAPER_WORKER_ENABLED=true
AUTO_BACKFILL_ON_EMPTY=true
GOALOO_REQUEST_INTERVAL=1
GOALOO_TIMEOUT=25
GOALOO_RETRIES=3
GOALOO_CONCURRENCY=2
GOALOO_SAVE_SNAPSHOTS=false

# Optional AI narrator: all four settings must be explicit before any network call.
NVIDIA_AI_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_DAILY_REQUEST_LIMIT=0
# Explicit outage mode: postgresql (live) or archive (no database writes).
STORAGE_BACKEND=postgresql
# Opt-in owned audit export. Keep these secrets outside Git.
ARCHIVE_DATABASE_URL=
ARCHIVE_ENCRYPTION_KEY=
ARCHIVE_GITHUB_TOKEN=
ARCHIVE_REPOSITORY=
ARCHIVE_RIGHTS_REFERENCE=
ARCHIVE_UPLOAD_ENABLED=false
# Optional local encrypted archive for the read-only /archive page.
ARCHIVE_FILE=
ARCHIVE_PUBLIC_SUMMARY_APPROVED=false
