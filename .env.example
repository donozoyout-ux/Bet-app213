DATABASE_URL=postgresql+asyncpg://betapp:replace-me@localhost:5432/betapp213
APP_ENV=development
LOG_LEVEL=INFO
SCRAPER_API_TOKEN=replace-with-a-long-random-token
SCRAPER_WORKER_ENABLED=true
AUTO_BACKFILL_ON_EMPTY=true
GOALOO_REQUEST_INTERVAL=1
GOALOO_TIMEOUT=25
GOALOO_RETRIES=3
GOALOO_CONCURRENCY=2
GOALOO_SAVE_SNAPSHOTS=false
R2_ENABLED=false
R2_RAW_CAPTURE_ENABLED=false
R2_REQUIRED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=replace-with-bucket-name
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
