DATABASE_URL=postgresql+asyncpg://betapp:replace-me@localhost:5432/betapp213
APP_ENV=development
LOG_LEVEL=INFO
SCRAPER_API_TOKEN=replace-with-a-long-random-token
SCRAPER_WORKER_ENABLED=true
AUTO_BACKFILL_ON_EMPTY=true
GOALOO_REQUEST_INTERVAL=1
GOALOO_TIMEOUT=25
GOALOO_RETRIES=3
GOALOO_CONCURRENCY=2
GOALOO_SAVE_SNAPSHOTS=false

# Optional AI narrator: all four settings must be explicit before any network call.
NVIDIA_AI_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_DAILY_REQUEST_LIMIT=0

# Cloudflare R2 archive/raw storage. PostgreSQL remains the operational source of truth.
R2_ENABLED=false
R2_REQUIRED=false
R2_RAW_CAPTURE_ENABLED=false
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=betapp213-storage

# Staged #130 rollout: history remains in PostgreSQL. No retention deletion.
HYBRID_HISTORY_ENABLED=false
SEASON_AGGREGATE_DIR=data/aggregates
